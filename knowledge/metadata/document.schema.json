{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "web",
        "pwn",
        "reverse",
        "crypto",
        "misc",
        "fundamentals",
        "tools",
        "workflows"
      ]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "source_path": {
      "type": "string",
      "pattern": "^(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.md$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "trust": {
      "const": "reference-only"
    }
  },
  "required": [
    "document_id",
    "title",
    "category",
    "tags",
    "summary",
    "source_path",
    "version",
    "content_hash",
    "trust"
  ],
  "additionalProperties": false
}
